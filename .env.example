# ---------------------------------------------------------------------------
# Supabase (required)
#
# Dashboard -> Project settings -> API. The anon key is designed to be public:
# Row Level Security in supabase/tables.sql is what actually protects your data.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# AI suggestions (optional)
#
# Everything works without these — task breakdown, tagging and time estimates
# fall back to the built-in rules in src/lib/ai/heuristics.js.
#
# PRODUCTION: point this at an endpoint you control that holds the real API key
# and forwards the prompt. It should accept POST { prompt, maxOutputTokens } and
# return { text }.
# ---------------------------------------------------------------------------
# VITE_AI_PROXY_URL=https://your-app.example.com/api/ai

# LOCAL DEVELOPMENT ONLY. Anything in a VITE_ variable is compiled into the
# JavaScript bundle and readable by anyone who opens devtools, so this key is
# deliberately ignored in production builds. Use VITE_AI_PROXY_URL to ship AI.
# VITE_GEMINI_API_KEY=your-dev-key
# VITE_GEMINI_MODEL=gemini-2.0-flash
